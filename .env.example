# Скопируйте в .env и заполните. В Git .env не коммитится.
# Обязательный минимум: Telegram. Остальные площадки включаются сами,
# когда появляются их переменные.

# === Telegram (канал + пульт) ===
TG_BOT_TOKEN=
TG_CHANNEL_ID=
TG_ADMIN_CHAT_ID=
# ID ветки/топика в группе, если публикуем в тему:
TG_MESSAGE_THREAD_ID=

# === Meta Threads ===
TH_USER_ID=
TH_ACCESS_TOKEN=

# === Bluesky ===
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# === Discord ===
DISCORD_WEBHOOK_URL=

# === Mastodon / Mathstodon ===
MASTODON_INSTANCE=https://mathstodon.xyz
MASTODON_ACCESS_TOKEN=

# === ВКонтакте ===
VK_GROUP_ID=
VK_ACCESS_TOKEN=

# === Cloudflare edge (опционально) ===
# Прокси картинок из Telegram CDN для Threads и сайта:
CF_WORKER_URL=
# Секрет для /api/ingest в Cloudflare Worker:
INGEST_SECRET=

# === Прочее ===
# Stack Exchange API key (не обязателен, поднимает лимит):
STACKEXCHANGE_API_KEY=
# Переопределения:
# SP_DATA_DIR=data
# SP_DIST_DIR=dist
# SP_SCHEDULE=09:00,18:00
# SP_SITE_BASE_URL=https://example.github.io/science-pulse
# SP_SITE_TITLE=Science Pulse
# SP_TRANSLATE=1
